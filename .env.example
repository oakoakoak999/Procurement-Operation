# Odoo credentials
ODOO_USERNAME=your_odoo_username
ODOO_PASSWORD=your_odoo_password

# Google OAuth — same credentials for Drive + Sheets (tnp.phr@gmail.com)
GDRIVE_CLIENT_ID=your_client_id
GDRIVE_CLIENT_SECRET=your_client_secret

# GitHub personal access token — for GitHub REST API / gh CLI (repo + workflow scope)
# Used to list/trigger GitHub Actions and read run status locally. Never commit the real value.
GH_TOKEN=your_github_pat

# ── Cloudflare Access service token (gha cloud door) ────────────────────────
# ONLY needed to reach Odoo through the `gha-` hostname from an untrusted
# datacenter/cloud IP (e.g. GitHub-hosted runner). Leave BOTH unset on a
# Cloudflare-trusted inside-network machine — the scripts send no CF headers then.
# Get the pair from IT (Access → Service Auth). Sent as CF-Access-Client-Id /
# CF-Access-Client-Secret headers on every Odoo request.
#
# UAT is the unsuffixed pair; production adds a _PROD suffix. The asymmetry is
# deliberate, not an oversight: the bare pair predates production access, and
# renaming it to _UAT would mean re-issuing a working token, because neither
# GitHub nor Cloudflare will show you a secret's value a second time.
#
# Leave these unset on a Cloudflare-trusted inside-network PC — the headers are
# only needed from an untrusted datacenter/cloud IP. Nothing falls back between
# environments: --env prod reads _PROD or sends no headers at all.
#
# The URL is NOT here — it lives in config.json / the CONFIG_JSON secret as
# `odooUrl` (UAT), `odooUrlProd` (production), and `odooUrlGha` (the UAT runner
# door, auto-selected when GITHUB_ACTIONS=true).
CF_ACCESS_CLIENT_ID=your_cf_access_client_id
CF_ACCESS_CLIENT_SECRET=your_cf_access_client_secret
#
# PRODUCTION — only the PO-daily pipeline may target it (--env prod). PR2PO,
# Confirm-PO and PR-action refuse to run against anything but UAT.
#   CF_ACCESS_CLIENT_ID_PROD     = <prod client id>
#   CF_ACCESS_CLIENT_SECRET_PROD = <prod client secret>
